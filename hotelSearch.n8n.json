    {
      "parameters": {
        "jsCode": "const data = items[0].json;\nconst hotels = Array.isArray(data.properties) \n  ? data.properties \n  : (Array.isArray(data.hotels) ? data.hotels : []);\n\nconst form = $node[\"On form submission\"].json;\nconst city = form[\"עיר\"];\nconst sortOption = form[\"מיין לפי\"]; // מה שהמשתמש בחר בטופס\nconst startDate = form[\"תאריך התחלה\"];\nconst nights = parseInt(form[\"מספר לילות\"] || 1, 10); // ברירת מחדל לילה אחד\n\n// מחשבים תאריך סיום\nlet endDate = \"\";\nif (startDate) {\n  const start = new Date(startDate);\n  start.setDate(start.getDate() + nights);\n  endDate = start.toISOString().split(\"T\")[0]; // פורמט YYYY-MM-DD\n}\n\n// נבנה מערך מלונות\nconst hotelList = hotels.map(h => {\n  let priceIls = null;\n\n  if (h.rate_per_night && typeof h.rate_per_night === \"object\") {\n    priceIls = h.rate_per_night.extracted_lowest || null;\n  } else if (h.rate_per_night_raw && typeof h.rate_per_night_raw === \"string\") {\n    try {\n      const parsed = JSON.parse(h.rate_per_night_raw);\n      priceIls = parsed.extracted_lowest || null;\n    } catch (e) {\n      priceIls = null;\n    }\n  } else if (typeof h.price === \"number\") {\n    priceIls = h.price;\n  }\n\n  return {\n    name: h.name || \"לא צויין\",\n    rating: h.overall_rating ? parseFloat(h.overall_rating) : null,\n    reviews: h.total_reviews || 0,\n    address: h.address || \"\",\n    priceIls,\n    link: h.link || \"\"\n  };\n})\n.filter(h => h.priceIls && h.link);\n\n// מיון דינמי לפי הבחירה בטופס\nif (sortOption === \"מחיר\") {\n  hotelList.sort((a, b) => a.priceIls - b.priceIls);\n} else if (sortOption === \"דירוג\") {\n  hotelList.sort((a, b) => (b.rating || 0) - (a.rating || 0));\n} else if (sortOption === \"כמות תגובות\") {\n  hotelList.sort((a, b) => (b.reviews || 0) - (a.reviews || 0));\n}\n\n// בניית הודעה\nlet message = `🏨 רשימת מלונות ב${city} 🏨\\n`;\nmessage += `👨‍👩‍👧‍👦 החיפוש מתייחס ל־2 מבוגרים ו־3 ילדים\\n`;\nmessage += `📅 תאריכים: ${startDate} → ${endDate}\\n`;\nmessage += `⚖️ מיון לפי: ${sortOption}\\n\\n`;\n\nfor (const h of hotelList) {\n  message +=\n    `📌 שם: ${h.name}\\n` +\n    (h.rating ? `⭐ דירוג: ${h.rating}\\n` : \"\") +\n    (h.address ? `📍 כתובת: ${h.address}\\n` : \"\") +\n    `💰 מחיר ללילה: ₪${h.priceIls}\\n` +\n    `🔗 [לינק](${h.link})\\n` +\n    `\\n───────────────────────\\n\\n`;\n}\n\n// חיתוך להודעות קטנות כדי לא להיתקע בטלגרם\nfunction splitMessage(str, size = 3500) {\n  const parts = [];\n  for (let i = 0; i < str.length; i += size) {\n    parts.push(str.slice(i, i + size));\n  }\n  return parts;\n}\n\nconst chunks = splitMessage(message);\n\nreturn chunks.map(c => ({ json: { message: c } }));\n"
      },
