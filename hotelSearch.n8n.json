      "parameters": {
        "jsCode": "const form = $node[\"On form submission\"].json;\nlet sortBy = form[\"מיין לפי\"];  // ערך שנבחר בטופס\nlet nights = parseInt(form[\"מספר לילות\"], 10); // המרה למספר\n\n// חישוב תאריך סיום לפי תאריך התחלה + מספר לילות\nlet startDate = new Date(form[\"תאריך התחלה\"]);\nlet endDate = new Date(startDate);\nendDate.setDate(startDate.getDate() + nights);\n\n// להחזיר בפורמט YYYY-MM-DD\nfunction formatDate(date) {\n  return date.toISOString().split(\"T\")[0];\n}\nlet startDateStr = formatDate(startDate);\nlet endDateStr = formatDate(endDate);\n\n// מיפוי בין הטקסט לערך המספרי\nconst mapping = {\n  \"מחיר\": 3,\n  \"דירוג\": 8\n};\nconst sortValue = mapping[sortBy] || null;\n\nreturn [{\n  json: {\n    עיר: form[\"עיר\"],\n    \"תאריך התחלה\": startDateStr,\n    \"תאריך סיום\": endDateStr,\n    \"מיין לפי\": sortValue\n  }\n}];\n"
